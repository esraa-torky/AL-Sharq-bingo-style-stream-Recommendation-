{
  "_note": "The three landing-page forms: field ids, types and options. Labels and option text live in landing.<lang>.json under the same ids. See CONTENT.md.",
  "shared": [
    {
      "id": "full_name",
      "type": "text",
      "required": true,
      "autocomplete": "name"
    },
    {
      "id": "email",
      "type": "email",
      "required": true,
      "autocomplete": "email"
    },
    {
      "id": "phone",
      "type": "tel",
      "required": false,
      "autocomplete": "tel"
    },
    {
      "id": "country",
      "type": "text",
      "required": true,
      "autocomplete": "country-name"
    },
    {
      "id": "city",
      "type": "text",
      "required": true,
      "autocomplete": "address-level2"
    },
    {
      "id": "age",
      "type": "select",
      "required": true,
      "options": [
        "under-18",
        "18-21",
        "22-35",
        "over-35"
      ]
    }
  ],
  "forms": [
    {
      "id": "join-hub",
      "sheet": "Join a hub",
      "fields": [
        {
          "id": "hub",
          "type": "hub",
          "required": true
        },
        {
          "id": "team",
          "type": "checkboxes",
          "required": false,
          "options": [
            "projects",
            "pr",
            "creative",
            "team-dev",
            "resources",
            "community"
          ]
        },
        {
          "id": "hours",
          "type": "select",
          "required": true,
          "options": [
            "under-5",
            "5-10",
            "over-10"
          ]
        },
        {
          "id": "motivation",
          "type": "textarea",
          "required": true
        }
      ]
    },
    {
      "id": "open-hub",
      "sheet": "Open a hub",
      "fields": [
        {
          "id": "hub_city",
          "type": "text",
          "required": true
        },
        {
          "id": "hub_country",
          "type": "text",
          "required": true
        },
        {
          "id": "why_city",
          "type": "textarea",
          "required": true
        },
        {
          "id": "experience",
          "type": "textarea",
          "required": true
        },
        {
          "id": "people",
          "type": "select",
          "required": true,
          "options": [
            "just-me",
            "2-4",
            "5-9",
            "10-plus"
          ]
        },
        {
          "id": "link",
          "type": "url",
          "required": false
        }
      ]
    },
    {
      "id": "join-program",
      "sheet": "Join a program",
      "fields": [
        {
          "id": "program",
          "type": "radios",
          "required": true,
          "options": [
            "F",
            "I",
            "H",
            "unsure"
          ]
        },
        {
          "id": "motivation",
          "type": "textarea",
          "required": true
        },
        {
          "id": "idea",
          "type": "textarea",
          "required": false,
          "showWhen": {
            "program": "I"
          }
        },
        {
          "id": "hours",
          "type": "select",
          "required": true,
          "options": [
            "under-5",
            "5-10",
            "over-10"
          ]
        },
        {
          "id": "member",
          "type": "radios",
          "required": true,
          "options": [
            "yes",
            "no",
            "applied"
          ]
        }
      ]
    }
  ],
  "regions": [
    "me",
